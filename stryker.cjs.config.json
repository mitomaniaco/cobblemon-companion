{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run real-damage player-import nbt"
  },
  "coverageAnalysis": "off",
  "mutate": ["electron/lib/nbt.cjs", "electron/lib/real-damage.cjs", "electron/player-import.cjs"],
  "mutator": {
    "excludedMutations": ["StringLiteral"]
  },
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation-cjs/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-cjs/mutation.json"
  },
  "tempDirName": ".stryker-tmp-cjs",
  "cleanTempDir": true,
  "timeoutMS": 20000,
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
