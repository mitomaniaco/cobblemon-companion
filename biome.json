{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**",
      "electron/**/*.cjs",
      "test/**/*.ts",
      "test/**/*.js",
      "test/**/*.cjs",
      "scripts/**",
      "*.json",
      "*.ts",
      "!**/dist",
      "!**/.runtime",
      "!src/data",
      "!package-lock.json",
      "!**/.stryker-tmp*",
      "!**/coverage",
      "!**/reports"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "bracketSpacing": false,
      "semicolons": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  }
}
